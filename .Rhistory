select(
CODUSU,          # Identificador de vivienda
AGLOMERADO,      # Código del aglomerado urbano
REGION,          # Código de región estadística
MAS_500,         # Aglomerado de 500.000+ hab. (S/N)
PONDERA,         # Factor de expansión (para estimar población)
